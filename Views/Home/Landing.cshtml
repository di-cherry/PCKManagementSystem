@model PCKManagementSystem.Models.ViewModels.LandingPageViewModel
@{
    ViewData["Title"] = "АИС ПЦК - Автоматизация учебно-методической работы";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
</head>
<body class="landing-page">
    <!-- Шапка -->
    <header class="landing-header">
        <nav class="landing-nav">
            <div class="logo">
                <i class="bi bi-diagram-3"></i>
                <span>АИС ПЦК</span>
            </div>
            <div class="nav-links">
                <a href="#features">Возможности</a>
                <a href="#about">О системе</a>
                <a href="#footer">Контакты</a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">Вход</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn" style="background: var(--gradient-end); color: white;">Регистрация</a>
            </div>
        </nav>
    </header>

    <!-- Hero секция -->
    <section class="hero-section">
        <div class="hero-content">
            <div class="hero-text animate__animated animate__fadeInLeft">
                <h1>Автоматизация работы предметно-цикловой комиссии</h1>
                <p>Современная информационная система для управления документами, учета нагрузки и контроля задач преподавателей колледжа</p>
                <div class="hero-buttons">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn">Начать работу</a>
                    <a href="#features" class="btn btn-outline">Узнать больше</a>
                </div>
            </div>
            <div class="hero-image animate__animated animate__fadeInRight">
                <img src="~/images/hero-illustration.svg" alt="Иллюстрация" onerror="this.style.display='none'">
                <i class="bi bi-files" style="font-size: 20rem; color: rgba(255,255,255,0.2);"></i>
            </div>
        </div>
    </section>

    <!-- Секция возможностей -->
    <section id="features" class="features-section">
        <div class="section-title">
            <h2>Возможности системы</h2>
            <p>Все необходимое для эффективной работы ПЦК в одном месте</p>
        </div>
        <div class="features-grid">
            <div class="feature-card animate__animated animate__fadeInUp">
                <div class="feature-icon">
                    <i class="bi bi-file-text"></i>
                </div>
                <h3>Управление документами</h3>
                <p>Создание, хранение и согласование учебно-методической документации. Автоматический контроль версий и статусов.</p>
            </div>
            <div class="feature-card animate__animated animate__fadeInUp" style="animation-delay: 0.2s">
                <div class="feature-icon">
                    <i class="bi bi-bar-chart"></i>
                </div>
                <h3>Учет нагрузки</h3>
                <p>Распределение учебной нагрузки между преподавателями, учет часов по дисциплинам и семестрам.</p>
            </div>
            <div class="feature-card animate__animated animate__fadeInUp" style="animation-delay: 0.4s">
                <div class="feature-icon">
                    <i class="bi bi-check2-square"></i>
                </div>
                <h3>Задачи и поручения</h3>
                <p>Постановка задач, контроль исполнения, автоматическое отслеживание просроченных поручений.</p>
            </div>
            <div class="feature-card animate__animated animate__fadeInUp" style="animation-delay: 0.6s">
                <div class="feature-icon">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                </div>
                <h3>Отчетность</h3>
                <p>Генерация отчетов в различных форматах (HTML, Excel, CSV) с возможностью фильтрации по параметрам.</p>
            </div>
            <div class="feature-card animate__animated animate__fadeInUp" style="animation-delay: 0.8s">
                <div class="feature-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3>Разграничение доступа</h3>
                <p>Три уровня доступа: администратор, председатель ПЦК, преподаватель. Каждый видит только свои данные.</p>
            </div>
            <div class="feature-card animate__animated animate__fadeInUp" style="animation-delay: 1s">
                <div class="feature-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h3>Журнал аудита</h3>
                <p>Фиксация всех действий пользователей для обеспечения прозрачности и контроля.</p>
            </div>
        </div>
    </section>

    <!-- Секция "О системе" -->
    <section id="about" class="features-section" style="background: var(--primary-light);">
        <div class="section-title">
            <h2 style="color: var(--gradient-end);">О системе</h2>
            <p>АИС ПЦК — это современное решение для автоматизации работы предметно-цикловой комиссии колледжа.</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <i class="bi bi-diagram-3" style="font-size: 3rem; color: var(--gradient-start);"></i>
                <h3>Для кого</h3>
                <p>Для председателей ПЦК, преподавателей и администраторов колледжа.</p>
            </div>
            <div class="feature-card">
                <i class="bi bi-clock-history" style="font-size: 3rem; color: var(--gradient-start);"></i>
                <h3>Экономия времени</h3>
                <p>Автоматизация рутинных процессов позволяет сосредоточиться на главном.</p>
            </div>
            <div class="feature-card">
                <i class="bi bi-shield-lock" style="font-size: 3rem; color: var(--gradient-start);"></i>
                <h3>Безопасность</h3>
                <p>Разграничение доступа и журнал аудита защищают данные.</p>
            </div>
        </div>
    </section>

    <!-- Объявления (если есть) -->
    @if (Model.RecentAnnouncements.Any())
    {
        <section class="features-section" style="background: #f8f9fa;">
            <div class="section-title">
                <h2>Последние новости</h2>
                <p>Актуальная информация от администрации</p>
            </div>
            <div class="features-grid" style="grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));">
                @foreach (var announcement in Model.RecentAnnouncements)
                {
                    <div class="feature-card">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-megaphone fs-1" style="color: var(--gradient-start);" me-3></i>
                            <div>
                                <h4 class="mb-1">@announcement.Title</h4>
                                <small class="text-muted">
                                    <i class="bi bi-person"></i> @(announcement.CreatedBy?.FullName ?? announcement.CreatedBy?.Email)
                                    <i class="bi bi-calendar ms-2"></i> @announcement.CreatedAt.ToString("dd.MM.yyyy")
                                </small>
                            </div>
                        </div>
                        <p class="text-muted">@announcement.Content</p>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Футер (теперь с градиентом, содержит все контакты) -->
    <footer id="footer" class="landing-footer">
        <div class="footer-content">
            <div class="footer-section">
                <h4><i class="bi bi-diagram-3"></i> АИС ПЦК</h4>
                <p>Автоматизированная информационная система для организации учебно-методической работы предметно-цикловой комиссии колледжа.</p>
                <div class="social-links">
                    <a href="#"><i class="bi bi-telegram"></i></a>
                    <a href="#"><i class="bi bi-vk"></i></a>
                    <a href="#"><i class="bi bi-github"></i></a>
                </div>
            </div>
            <div class="footer-section">
                <h4>Навигация</h4>
                <ul>
                    <li><a href="#features">Возможности</a></li>
                    <li><a href="#about">О системе</a></li>
                    <li><a href="#footer">Контакты</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Контакты</h4>
                <ul>
                    <li><i class="bi bi-envelope"></i> info@pck.ru</li>
                    <li><i class="bi bi-telephone"></i> +7 (495) 123-45-67</li>
                    <li><i class="bi bi-geo-alt"></i> г. Москва, ул. Образцова, д. 1</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.UtcNow.Year - АИС ПЦК. Все права защищены.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Плавная прокрутка к якорям
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Анимация при скролле
        const animateOnScroll = function() {
            const elements = document.querySelectorAll('.animate__animated');
            elements.forEach(element => {
                const elementTop = element.getBoundingClientRect().top;
                const windowHeight = window.innerHeight;
                if (elementTop < windowHeight - 100) {
                    element.style.opacity = '1';
                    element.style.visibility = 'visible';
                }
            });
        };
        window.addEventListener('scroll', animateOnScroll);
        animateOnScroll();
    </script>
</body>
</html>