@model IEnumerable<PCKManagementSystem.Models.ViewModels.TeacherViewModel>
@{
    ViewData["Title"] = "Преподаватели";
    var searchString = ViewData["CurrentFilter"] as string;
    var positionFilter = ViewData["CurrentPosition"] as string;
    var degreeFilter = ViewData["CurrentDegree"] as string;
    var qualificationFilter = ViewData["CurrentQualification"] as string;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        @if (User.IsInRole("Администратор") || User.IsInRole("Председатель ПЦК"))
        {
            <a asp-action="ExportToExcel" asp-route-searchString="@searchString"
               asp-route-position="@positionFilter" asp-route-degree="@degreeFilter" asp-route-qualification="@qualificationFilter"
               class="btn btn-success rounded-pill">
                <i class="bi bi-file-earmark-excel"></i> Экспорт в Excel
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Фильтры -->
    <div class="filters-section mb-4">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Поиск</label>
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="ФИО, email..." value="@searchString" />
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
                    @if (!string.IsNullOrEmpty(searchString))
                    {
                        <a href="@Url.Action("Index", new { position = positionFilter, degree = degreeFilter, qualification = qualificationFilter })" class="btn btn-outline-danger">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Должность</label>
                <select name="position" class="form-select modern-select" onchange="this.form.submit()">
                    <option value="">Все</option>
                    @foreach (var pos in ViewBag.Positions ?? new List<string>())
                    {
                        <option value="@pos" selected="@(pos == positionFilter)">@pos</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Учёная степень</label>
                <select name="degree" class="form-select modern-select" onchange="this.form.submit()">
                    <option value="">Все</option>
                    @foreach (var deg in ViewBag.Degrees ?? new List<string>())
                    {
                        <option value="@deg" selected="@(deg == degreeFilter)">@deg</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Квалификация</label>
                <select name="qualification" class="form-select modern-select" onchange="this.form.submit()">
                    <option value="">Все</option>
                    @foreach (var qual in ViewBag.Qualifications ?? new List<string>())
                    {
                        <option value="@qual" selected="@(qual == qualificationFilter)">@qual</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Сбросить фильтры</a>
            </div>
        </form>
    </div>

    <!-- Карточки преподавателей -->
    <div class="row">
        @foreach (var teacher in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar-circle me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                                @(teacher.FullName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <h5 class="mb-0">@teacher.FullName</h5>
                                <small class="text-muted">@(teacher.Position ?? "Должность не указана")</small>
                            </div>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-envelope"></i> @teacher.Email
                        </div>
                        @if (!string.IsNullOrEmpty(teacher.Degree))
                        {
                            <div class="small"><i class="bi bi-award"></i> @teacher.Degree</div>
                        }
                        @if (teacher.ExperienceYears.HasValue)
                        {
                            <div class="small"><i class="bi bi-briefcase"></i> Опыт: @teacher.ExperienceYears лет</div>
                        }
                        <div class="mt-2">
                            <span class="badge @(teacher.IsActive ? "bg-success" : "bg-danger")">@(teacher.IsActive ? "Активен" : "Заблокирован")</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-sm btn-outline-primary rounded-pill flex-fill text-center">
                                <i class="bi bi-eye"></i> Подробнее
                            </a>
                            @if (User.IsInRole("Администратор") || User.IsInRole("Председатель ПЦК"))
                            {
                                <a asp-action="Edit" asp-route-id="@teacher.Id" class="btn btn-sm btn-outline-warning rounded-pill flex-fill text-center">
                                    <i class="bi bi-pencil"></i> Редактировать
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-person-badge fs-1 text-muted"></i>
            <p class="text-muted mt-2">Преподаватели не найдены</p>
        </div>
    }
</div>