@model PCKManagementSystem.Models.Document

@{
    ViewData["Title"] = "Удаление документа";
}

<div class="container">
    <h1 class="mb-4"><i class="bi bi-trash3 me-2"></i>@ViewData["Title"]</h1>

    <div class="alert alert-warning">
        <h5>Вы уверены, что хотите удалить этот документ?</h5>
        <p class="mb-0">Это действие нельзя отменить. Файл будет также удален с сервера.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3"><i class="bi bi-file-text me-2"></i>Название:</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3"><i class="bi bi-tag me-2"></i>Тип документа:</dt>
                        <dd class="col-sm-9">@Model.DocumentType</dd>

                        <dt class="col-sm-3"><i class="bi bi-code-square me-2"></i>Версия:</dt>
                        <dd class="col-sm-9">@Model.Version</dd>

                        <dt class="col-sm-3"><i class="bi bi-book me-2"></i>Дисциплина:</dt>
                        <dd class="col-sm-9">@Model.Discipline?.Name</dd>

                        <dt class="col-sm-3"><i class="bi bi-person me-2"></i>Автор:</dt>
                        <dd class="col-sm-9">@Model.Author?.FullName</dd>

                        <dt class="col-sm-3"><i class="bi bi-calendar me-2"></i>Дата создания:</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                <i class="bi bi-trash me-2"></i>Подтвердить удаление
                            </button>
                            <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                                <i class="bi bi-x-circle me-2"></i>Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>