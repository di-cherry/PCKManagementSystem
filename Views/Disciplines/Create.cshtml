@model PCKManagementSystem.Models.Discipline

@{
    ViewData["Title"] = "Добавление дисциплины";
}

<div class="container">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Код дисциплины с иконкой -->
                        <div class="form-group mb-3">
                            <label asp-for="Code" class="control-label fw-semibold required-field">Код дисциплины</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                                <input asp-for="Code" class="form-control" placeholder="Например: ОП.01" />
                            </div>
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <!-- Название дисциплины -->
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="control-label fw-semibold required-field">Название дисциплины</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-book"></i></span>
                                <input asp-for="Name" class="form-control" placeholder="Например: Основы программирования" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Специальность (выпадающий список) -->
                        <div class="form-group mb-4">
                            <label asp-for="SpecialtyId" class="control-label fw-semibold required-field">Специальность</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-diagram-3"></i></span>
                                <select asp-for="SpecialtyId" class="form-control" asp-items="ViewBag.Specialties">
                                    <option value="">-- Выберите специальность --</option>
                                </select>
                            </div>
                            <span asp-validation-for="SpecialtyId" class="text-danger"></span>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-save me-2"></i>Сохранить
                            </button>
                            <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                                <i class="bi bi-x-circle me-2"></i>Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}