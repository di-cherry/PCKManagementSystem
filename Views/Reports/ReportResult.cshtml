@model object
@{
    ViewData["Title"] = "Результат отчета";
    var reportId = ViewBag.ReportId;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> К списку отчетов
            </a>
            @if (reportId != null)
            {
                <a asp-action="Details" asp-route-id="@reportId" class="btn btn-info">
                    <i class="bi bi-info-circle"></i> Подробнее
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (Model is PCKManagementSystem.Models.ViewModels.DocumentsReportViewModel docReport)
            {
                @await Html.PartialAsync("_DocumentsReport", docReport)
            }
            else if (Model is PCKManagementSystem.Models.ViewModels.WorkloadReportViewModel workloadReport)
            {
                @await Html.PartialAsync("_WorkloadReport", workloadReport)
            }
            else if (Model is PCKManagementSystem.Models.ViewModels.TasksReportViewModel tasksReport)
            {
                @await Html.PartialAsync("_TasksReport", tasksReport)
            }
            else if (Model is PCKManagementSystem.Models.ViewModels.ActivityReportViewModel activityReport)
            {
                @await Html.PartialAsync("_ActivityReport", activityReport)
            }
            else
            {
                <div class="alert alert-warning">
                    Неизвестный тип отчета
                </div>
            }
        </div>
    </div>
</div>