@model IEnumerable<PCKManagementSystem.Models.ViewModels.AnnouncementViewModel>
@{
    ViewData["Title"] = "Управление объявлениями";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="CreateAnnouncement" class="btn btn-primary rounded-pill">
            <i class="bi bi-megaphone"></i> Создать объявление
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @foreach (var announcement in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow rounded-4 h-100 @(announcement.IsActive ? "" : "border-secondary")">
                    <div class="card-header @(announcement.IsActive ? "bg-primary text-white" : "bg-secondary text-white") rounded-top-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                @if (!announcement.IsActive)
                                {
                                    <i class="bi bi-eye-slash me-2"></i>
                                }
                                else
                                {
                                    <i class="bi bi-megaphone me-2"></i>
                                }
                                @announcement.Title
                            </h5>
                            <div>
                                <span class="badge @(announcement.IsActive ? "bg-light text-dark" : "bg-dark")">
                                    @announcement.CreatedAt.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@announcement.Content</p>
                        <small class="text-muted">
                            <i class="bi bi-person"></i> Создал: @announcement.CreatedByName
                        </small>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="EditAnnouncement" asp-route-id="@announcement.Id" class="btn btn-warning rounded-pill">
                            <i class="bi bi-pencil"></i> Редактировать
                        </a>
                        <form asp-action="DeleteAnnouncement" asp-route-id="@announcement.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Удалить объявление?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill">
                                <i class="bi bi-trash"></i> Удалить
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-4">
            <i class="bi bi-megaphone fs-1 text-muted"></i>
            <p class="text-muted mt-2">Нет объявлений</p>
            <a asp-action="CreateAnnouncement" class="btn btn-primary rounded-pill">Создать первое объявление</a>
        </div>
    }
</div>