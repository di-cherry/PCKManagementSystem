@model IEnumerable<PCKManagementSystem.Models.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "Управление пользователями";
    var sortOrder = Context.Request.Query["sortOrder"].ToString();
    var searchString = Context.Request.Query["searchString"].ToString();
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <div class="d-flex gap-2">
            <a asp-action="CreateUser" class="btn btn-primary rounded-pill">
                <i class="bi bi-person-plus"></i> Добавить пользователя
            </a>
            <div class="dropdown d-inline-block">
                <button class="btn btn-success rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download"></i> Экспорт
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" asp-action="ExportUsersToExcel">
                            <i class="bi bi-people"></i> Все пользователи
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="ExportUsersToExcel" asp-route-role="Преподаватель">
                            <i class="bi bi-person-workspace"></i> Только преподаватели
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="ExportUsersToExcel" asp-route-isActive="true">
                            <i class="bi bi-check-circle"></i> Только активные
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="ExportUsersToExcel" asp-route-isActive="false">
                            <i class="bi bi-lock"></i> Только заблокированные
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Фильтры -->
    <div class="filters-section mb-4">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Поиск</label>
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Имя или email..." value="@ViewData["CurrentFilter"]" />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                    {
                        <a href="@Url.Action("Users", new { sortOrder = ViewData["CurrentSort"] })" class="btn btn-outline-danger">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Users" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Сбросить
                </a>
            </div>
        </form>
    </div>

    <!-- Таблица -->
    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-modern mb-0">
                    <thead>
                        <tr>
                            <th>
                                <a asp-action="Users" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">Пользователь</a>
                            </th>
                            <th>
                                <a asp-action="Users" asp-route-sortOrder="@ViewData["EmailSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">Email</a>
                            </th>
                            <th>Роли</th>
                            <th>Статус</th>
                            <th>
                                <a asp-action="Users" asp-route-sortOrder="@ViewData["CreatedSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">Дата регистрации</a>
                            </th>
                            <th>
                                <a asp-action="Users" asp-route-sortOrder="@ViewData["LastLoginSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">Последний вход</a>
                            </th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="avatar-circle me-2">@(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName.Substring(0, 1).ToUpper())</span>
                                        <strong>@(string.IsNullOrEmpty(user.FullName) ? "—" : user.FullName)</strong>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-info me-1">@role</span>
                                    }
                                    @if (!user.Roles.Any())
                                    {
                                        <span class="badge bg-secondary">Нет ролей</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @user.StatusClass">@user.StatusDisplay</span>
                                </td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (user.LastLoginAt.HasValue)
                                    {
                                        @user.LastLoginAt.Value.ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Никогда</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-warning" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleBlock" asp-route-id="@user.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-@(user.IsActive ? "danger" : "success")"
                                                    title="@(user.IsActive ? "Заблокировать" : "Разблокировать")">
                                                <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-outline-dark" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <p class="text-muted mt-2">Пользователи не найдены</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(() => $('.alert').fadeOut('slow'), 5000);
    </script>
}