<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - АИС ПЦК</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <!-- Верхняя панель -->
        <nav class="navbar navbar-light bg-white border-bottom py-2">
            <div class="container-fluid">
                <div class="d-flex align-items-center">
                    <!-- Кнопка-бургер ТОЛЬКО для авторизованных -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="btn btn-outline-primary me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar">
                            <i class="bi bi-list fs-4"></i>
                        </button>
                    }
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-diagram-3"></i> АИС ПЦК
                    </a>
                </div>
                <!-- _LoginPartial отображает либо кнопки входа/регистрации, либо профиль -->
                <partial name="_LoginPartial" />
            </div>
        </nav>

        <!-- Offcanvas меню ТОЛЬКО для авторизованных -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="offcanvasNavbarLabel">
                        <i class="bi bi-diagram-3"></i> АИС ПЦК
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
                <div class="offcanvas-body">
                    <ul class="navbar-nav justify-content-start flex-grow-1 pe-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Documents" asp-action="Index">
                                <i class="bi bi-files"></i> Документы
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Teachers" asp-action="Index">
                                <i class="bi bi-person-badge"></i> Преподаватели
                            </a>
                        </li>

                        <!-- Задачи (с подменю) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="tasksOffcanvasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-check2-square"></i> Задачи
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="tasksOffcanvasDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Tasks" asp-action="Index">
                                        <i class="bi bi-list"></i> Все задачи
                                    </a>
                                </li>
                                @if (User.IsInRole("Преподаватель"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Tasks" asp-action="MyTasks">
                                            <i class="bi bi-person"></i> Мои задачи
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole("Администратор") || User.IsInRole("Председатель ПЦК"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Tasks" asp-action="Create">
                                            <i class="bi bi-plus-circle"></i> Создать задачу
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Disciplines" asp-action="Index">
                                <i class="bi bi-book"></i> Дисциплины
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Specialties" asp-action="Index">
                                <i class="bi bi-mortarboard"></i> Специальности
                            </a>
                        </li>

                        @if (User.IsInRole("Администратор") || User.IsInRole("Председатель ПЦК"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Workload" asp-action="Index">
                                    <i class="bi bi-bar-chart"></i> Нагрузка
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-file-earmark-bar-graph"></i> Отчеты
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Преподаватель"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Workload" asp-action="MyLoad">
                                    <i class="bi bi-person-workspace"></i> Моя нагрузка
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Председатель ПЦК"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Announcements">
                                    <i class="bi bi-megaphone"></i> Объявления
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Администратор"))
                        {
                            <!-- Администрирование с подменю -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminOffcanvasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear"></i> Администрирование
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminOffcanvasDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-speedometer2"></i> Панель управления
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                            <i class="bi bi-people"></i> Пользователи
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="AuditLog">
                                            <i class="bi bi-journal-text"></i> Журнал аудита
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Announcements">
                                            <i class="bi bi-megaphone"></i> Объявления
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            }
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/ru.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveNotification", (message, url) => {
            showToast(message, url);
        });

        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch(err => console.error("SignalR connection error: ", err));

        function showToast(message, url) {
            let toastContainer = document.getElementById('toastContainer');
            if (!toastContainer) {
                toastContainer = document.createElement('div');
                toastContainer.id = 'toastContainer';
                toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                toastContainer.style.zIndex = '1050';
                document.body.appendChild(toastContainer);
            }

            const toastId = 'toast-' + Date.now();
            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
                    <div class="d-flex">
                        <div class="toast-body">
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            toastContainer.insertAdjacentHTML('beforeend', toastHtml);

            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement);
            toast.show();

            if (url) {
                toastElement.addEventListener('click', function() {
                    window.location.href = url;
                });
                toastElement.style.cursor = 'pointer';
            }

            toastElement.addEventListener('hidden.bs.toast', function() {
                toastElement.remove();
            });
        }
    </script>
    <script>
        // Обработчик для кнопок удаления: сохраняем URL и открываем модалку
        document.addEventListener('click', function (e) {
            var deleteBtn = e.target.closest('.delete-item');
            if (deleteBtn) {
                e.preventDefault();
                var deleteUrl = deleteBtn.getAttribute('href');
                document.getElementById('confirmDeleteBtn').setAttribute('href', deleteUrl);
                new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
            }
        });
    </script>
</body>
</html>