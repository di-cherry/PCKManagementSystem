@page
@{
    ViewData["Title"] = "Доступ запрещен";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body text-center">
                    <i class="bi bi-shield-lock" style="font-size: 4rem; color: #dc3545;"></i>
                    <h5 class="mt-3">У вас нет прав для доступа к этой странице.</h5>
                    <p class="text-muted">Обратитесь к администратору для получения необходимых прав.</p>
                    <a href="/" class="btn btn-primary mt-3">Вернуться на главную</a>
                </div>
            </div>
        </div>
    </div>
</div>