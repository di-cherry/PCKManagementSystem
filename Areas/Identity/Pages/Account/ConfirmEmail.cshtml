@page
@model PCKManagementSystem.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
	ViewData["Title"] = "Подтверждение email";
}
<h1>@ViewData["Title"]</h1>
<div>
    @if (Model.StatusMessage != null)
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }
    else
    {
        <div class="alert alert-danger">Ошибка подтверждения email.</div>
    }
    <a asp-page="./Login">Войти</a>
</div>